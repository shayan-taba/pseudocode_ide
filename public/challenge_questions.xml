<?xml version="1.0" encoding="UTF-8"?>
<challenges>
  <challenge>
    <id>1</id>
    <title>Sum of Array Elements</title>
    <description>Write an algorithm to compute the sum of all elements in an array.</description>
    <tags>
      <tag>Arrays</tag>
      <tag>Loops</tag>
    </tags>
    <dataTypes>
      <input>Array of integers</input>
      <output>Integer representing the sum of the elements</output>
    </dataTypes>
    <difficulty>SL</difficulty>
    <type>Algorithm</type>
    <testCases>
      <testCase>
        <input>[1, 2, 3, 4]</input>
        <output>10</output>
      </testCase>
      <testCase>
        <input>[0, 0, 0]</input>
        <output>0</output>
      </testCase>
      <testCase>
        <input>[10, -5, 15]</input>
        <output>20</output>
      </testCase>
    </testCases>
  </challenge>

  <challenge>
    <id>2</id>
    <title>Check if Collection is Empty</title>
    <description>Write an algorithm that checks if a collection is empty and outputs "Empty" or "Not Empty".</description>
    <tags>
      <tag>Collections</tag>
    </tags>
    <dataTypes>
      <input>Collection</input>
      <output>String indicating whether the collection is empty</output>
    </dataTypes>
    <difficulty>SL</difficulty>
    <type>Condition</type>
    <testCases>
      <testCase>
        <input>Collection()</input>
        <output>Empty</output>
      </testCase>
      <testCase>
        <input>Collection(5, 10, 15)</input>
        <output>Not Empty</output>
      </testCase>
      <testCase>
        <input>Collection("A")</input>
        <output>Not Empty</output>
      </testCase>
    </testCases>
  </challenge>

  <challenge>
    <id>3</id>
    <title>Reverse Array Using Stack</title>
    <description>Write an algorithm to reverse an array using a stack.</description>
    <tags>
      <tag>Arrays</tag>
      <tag>Stacks</tag>
    </tags>
    <dataTypes>
      <input>Array of integers</input>
      <output>Array of integers in reverse order</output>
    </dataTypes>
    <difficulty>HL</difficulty>
    <type>Algorithm</type>
    <testCases>
      <testCase>
        <input>[1, 2, 3]</input>
        <output>[3, 2, 1]</output>
      </testCase>
      <testCase>
        <input>[5, 10]</input>
        <output>[10, 5]</output>
      </testCase>
      <testCase>
        <input>[8]</input>
        <output>[8]</output>
      </testCase>
    </testCases>
  </challenge>

  <challenge>
    <id>4</id>
    <title>Queue Simulation</title>
    <description>Simulate a queue where elements are added and removed, and output the final state of the queue.</description>
    <tags>
      <tag>Queues</tag>
    </tags>
    <dataTypes>
      <input>Sequence of operations</input>
      <output>Final state of the queue</output>
    </dataTypes>
    <difficulty>HL</difficulty>
    <type>Simulation</type>
    <testCases>
      <testCase>
        <input>[enqueue(1), enqueue(2), dequeue(), enqueue(3)]</input>
        <output>Queue(2, 3)</output>
      </testCase>
      <testCase>
        <input>[enqueue("A"), enqueue("B"), dequeue(), dequeue()]</input>
        <output>Queue()</output>
      </testCase>
      <testCase>
        <input>[enqueue(10), dequeue(), enqueue(20), enqueue(30)]</input>
        <output>Queue(20, 30)</output>
      </testCase>
    </testCases>
  </challenge>

  <challenge>
    <id>5</id>
    <title>Find Maximum in Collection</title>
    <description>Write an algorithm to find the maximum value in a collection.</description>
    <tags>
      <tag>Collections</tag>
      <tag>Loops</tag>
    </tags>
    <dataTypes>
      <input>Collection of integers</input>
      <inputName>COLLECTION_TEST_CASE</inputName>
      <output>Maximum integer value</output>
    </dataTypes>
    <difficulty>SL</difficulty>
    <type>Algorithm</type>
    <testCases>
      <testCase>
        <input>"1"</input>
        <output>4</output>
      </testCase>
      <testCase>
        <input>Collection(-5, -2, -3)</input>
        <output>-2</output>
      </testCase>
      <testCase>
        <input>Collection(10)</input>
        <output>10</output>
      </testCase>
    </testCases>
  </challenge>
</challenges>
