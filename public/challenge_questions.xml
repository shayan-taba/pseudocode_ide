<challenges>
  <challenge>
    <id>1</id>
    <title>Count Numbers in Range</title>
    <description>Write an algorithm to count how many numbers in a collection are odd negative integers.</description>
    <tags>
      <tag>Collections</tag>
      <tag>Loops</tag>
    </tags>
    <dataTypes>
      <inputType>Collection of numbers</inputType>
      <inputName>NUMBERS</inputName>
      <outputType>Integer count</outputType>
    </dataTypes>
    <difficulty>SL</difficulty>
    <type>Algorithm</type>
    <testCases>
      <testCase>
        <input>Collection(-0.5, 0.8, 2, -1, 1.5)</input>
        <output>1</output>
      </testCase>
      <testCase>
        <input>Collection(-5, -2, 3,-7)</input>
        <output>3</output>
      </testCase>
      <testCase>
        <input>Collection(1, -1, -23)</input>
        <output>2</output>
      </testCase>
    </testCases>
  </challenge>

  <challenge>
    <id>2</id>
    <title>Reverse Queue Elements</title>
    <description>Write an algorithm to reverse the order of elements in a queue.</description>
    <tags>
      <tag>Queues</tag>
      <tag>Stacks</tag>
    </tags>
    <dataTypes>
      <inputType>Queue of strings</inputType>
      <inputName>QUEUE</inputName>
      <outputType>Queue of strings in reverse order</outputType>
    </dataTypes>
    <difficulty>HL</difficulty>
    <type>Algorithm</type>
    <testCases>
      <testCase>
        <input>Queue("a", "b", "c")</input>
        <output>Queue(["c", "b", "a"])</output>
      </testCase>
      <testCase>
        <input>Queue("1", "2", "3", "4")</input>
        <output>Queue(["4", "3", "2", "1"])</output>
      </testCase>
      <testCase>
        <input>Queue("cat")</input>
        <output>Queue(["cat"])</output>
      </testCase>
    </testCases>
  </challenge>

  <challenge>
    <id>3</id>
    <title>Find Common IDs</title>
    <description>Write an algorithm to find the number of students who study both math and economics.</description>
    <tags>
      <tag>Collections</tag>
      <tag>Conditionals</tag>
    </tags>
    <dataTypes>
      <inputType>Collection of student IDs of math students.</inputType>
      <inputName>MATH</inputName>
      <inputType>Collection of student IDs for economics students.</inputType>
      <inputName>ECONOMICS</inputName>
      <outputType>Integer count</outputType>
    </dataTypes>
    <difficulty>SL</difficulty>
    <type>Algorithm</type>
    <testCases>
      <testCase>
        <input>Collection(101, 102, 103)</input>
        <input>Collection(102, 103, 104)</input>
        <output>2</output>
      </testCase>
      <testCase>
        <input>Collection(100, 200)</input>
        <input>Collection(300, 400)</input>
        <output>0</output>
      </testCase>
      <testCase>
        <input>Collection(1, 2, 3, 4, 5)</input>
        <input>Collection(4, 5, 6, 7)</input>
        <output>2</output>
      </testCase>
    </testCases>
  </challenge>

  <challenge>
    <id>4</id>
    <title>Stack Sort</title>
    <description>Write an algorithm to sort a stack of integers in ascending order using a second stack.</description>
    <tags>
      <tag>Stacks</tag>
      <tag>Sorting</tag>
    </tags>
    <dataTypes>
      <inputType>Stack of integers</inputType>
      <inputName>STACK</inputName>
      <outputType>Stack of integers in ascending order</outputType>
    </dataTypes>
    <difficulty>HL</difficulty>
    <type>Algorithm</type>
    <testCases>
      <testCase>
        <input>Stack(3, 1, 4, 2)</input>
        <output>Stack([1, 2, 3, 4])</output>
      </testCase>
      <testCase>
        <input>Stack(5, 1, 3)</input>
        <output>Stack([1, 3, 5])</output>
      </testCase>
      <testCase>
        <input>Stack(10)</input>
        <output>Stack([10])</output>
      </testCase>
    </testCases>
  </challenge>

  <challenge>
    <id>5</id>
    <title>Simulate Elevator</title>
    <description>Write an algorithm to simulate the operations of an elevator using a queue. Assume the queue holds the floor numbers where the elevator must stop.</description>
    <tags>
      <tag>Queues</tag>
      <tag>Simulation</tag>
    </tags>
    <dataTypes>
      <inputType>Queue of integers</inputType>
      <inputName>FLOORS</inputName>
      <outputType>Sequence of elevator stops</outputType>
    </dataTypes>
    <difficulty>HL</difficulty>
    <type>Algorithm</type>
    <testCases>
      <testCase>
        <input>Queue(1, 3, 5, 2)</input>
        <output>Queue([1, 3, 5, 2])</output>
      </testCase>
      <testCase>
        <input>Queue(10, 1, 7)</input>
        <output>Queue([10, 1, 7])</output>
      </testCase>
      <testCase>
        <input>Queue(2)</input>
        <output>Queue([2])</output>
      </testCase>
    </testCases>
  </challenge>

  <challenge>
    <id>6</id>
    <title>Bracket Matching</title>
    <description>Write an algorithm to check if the brackets in a string are balanced using a stack.</description>
    <tags>
      <tag>Stacks</tag>
      <tag>Conditionals</tag>
    </tags>
    <dataTypes>
      <inputType>String of brackets</inputType>
      <inputName>BRACKETS</inputName>
      <outputType>Boolean indicating if brackets are balanced</outputType>
    </dataTypes>
    <difficulty>HL</difficulty>
    <type>Algorithm</type>
    <testCases>
      <testCase>
        <input>"()[]{}"</input>
        <output>True</output>
      </testCase>
      <testCase>
        <input>"([)]"</input>
        <output>False</output>
      </testCase>
      <testCase>
        <input>"((()))"</input>
        <output>True</output>
      </testCase>
    </testCases>
  </challenge>

  <challenge>
    <id>7</id>
    <title>Merge Two Collections</title>
    <description>Write an algorithm to merge two collections into one and remove duplicates.</description>
    <tags>
      <tag>Collections</tag>
      <tag>Loops</tag>
    </tags>
    <dataTypes>
      <inputType>Collection of integers</inputType>
      <inputName>COLLECTION1</inputName>
      <inputType>Collection of integers</inputType>
      <inputName>COLLECTION2</inputName>
      <outputType>Collection of unique integers</outputType>
    </dataTypes>
    <difficulty>SL</difficulty>
    <type>Algorithm</type>
    <testCases>
      <testCase>
        <input>Collection(1, 2, 3)</input>
        <input>Collection(3, 4, 5)</input>
        <output>Collection([1, 2, 3, 4, 5])</output>
      </testCase>
      <testCase>
        <input>Collection(10, 20)</input>
        <input>Collection(20, 30, 40)</input>
        <output>Collection([10, 20, 30, 40])</output>
      </testCase>
      <testCase>
        <input>Collection()</input>
        <input>Collection(1, 2)</input>
        <output>Collection([1, 2])</output>
      </testCase>
    </testCases>
  </challenge>

  <challenge>
    <id>8</id>
    <title>Generate Random Queue</title>
    <description>Write an algorithm to generate a queue of random integers given a specified size and range.</description>
    <tags>
      <tag>Queues</tag>
      <tag>Random</tag>
    </tags>
    <dataTypes>
      <inputType>Integer size</inputType>
      <inputName>SIZE</inputName>
      <inputType>Integer range</inputType>
      <inputName>RANGE</inputName>
      <outputType>Queue of random integers</outputType>
    </dataTypes>
    <difficulty>SL</difficulty>
    <type>Algorithm</type>
    <testCases>
      <testCase>
        <input>5</input>
        <input>10</input>
        <output>Queue([random])</output>
      </testCase>
      <testCase>
        <input>3</input>
        <input>100</input>
        <output>Queue([random])</output>
      </testCase>
      <testCase>
        <input>1</input>
        <input>50</input>
        <output>Queue([random])</output>
      </testCase>
    </testCases>
  </challenge>
</challenges>
