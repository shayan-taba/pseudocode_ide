<challenges>
  <challenge>
    <id>1</id>
    <title>Count Numbers in Range</title>
    <description>Write an algorithm to count how many numbers in a collection are both even and negative numbers.</description>
    <tags>
      <tag>Collections</tag>
      <tag>Loops</tag>
    </tags>
    <dataTypes>
      <inputType>Collection of numbers</inputType>
      <inputName>NUMBERS</inputName>
      <outputType>Integer count</outputType>
    </dataTypes>
    <difficulty>SL</difficulty>
    <type>Algorithm</type>
    <testCases>
      <testCase>
        <input>Collection(-2, 0.8, 2, -1, 1.5)</input>
        <output>1</output>
      </testCase>
      <testCase>
        <input>Collection(-5, 1, 3,-7)</input>
        <output>0</output>
      </testCase>
      <testCase>
        <input>Collection(1, -1, -2, -4)</input>
        <output>2</output>
      </testCase>
    </testCases>
  </challenge>
  <challenge>
    <id>2</id>
    <title>Reverse Queue Elements</title>
    <description>Write an algorithm to reverse the order of elements in a queue.</description>
    <tags>
      <tag>Queues</tag>
      <tag>Stacks</tag>
    </tags>
    <dataTypes>
      <inputType>Queue of strings</inputType>
      <inputName>QUEUE</inputName>
      <outputType>Queue of strings in reverse order</outputType>
    </dataTypes>
    <difficulty>HL</difficulty>
    <type>Algorithm</type>
    <testCases>
      <testCase>
        <input>Queue(CustomString("a"),CustomString("b"),CustomString("c"))</input>
        <output>Queue(["c"),CustomString("b"),CustomString("a"])</output>
      </testCase>
      <testCase>
        <input>Queue("1"),CustomString("2"),CustomString("3"),CustomString("4")</input>
        <output>Queue(["4"),CustomString("3"),CustomString("2"),CustomString("1"])</output>
      </testCase>
      <testCase>
        <input>Queue("cat")</input>
        <output>Queue(["cat"])</output>
      </testCase>
    </testCases>
  </challenge>
  <challenge>
    <id>3</id>
    <title>Find Common IDs</title>
    <description>Write an algorithm to find the number of students who study both math and economics.</description>
    <tags>
      <tag>Collections</tag>
      <tag>Conditionals</tag>
    </tags>
    <dataTypes>
      <inputType>Collection of student IDs of math students.</inputType>
      <inputName>MATH</inputName>
      <inputType>Collection of student IDs for economics students.</inputType>
      <inputName>ECONOMICS</inputName>
      <outputType>Integer count</outputType>
    </dataTypes>
    <difficulty>SL</difficulty>
    <type>Algorithm</type>
    <testCases>
      <testCase>
        <input>Collection(101, 102, 103)</input>
        <input>Collection(102, 103, 104)</input>
        <output>2</output>
      </testCase>
      <testCase>
        <input>Collection(100, 200)</input>
        <input>Collection(300, 400)</input>
        <output>0</output>
      </testCase>
      <testCase>
        <input>Collection(1, 2, 3, 4, 5)</input>
        <input>Collection(4, 5, 6, 7)</input>
        <output>2</output>
      </testCase>
    </testCases>
  </challenge>
  <challenge>
    <id>4</id>
    <title>Stack Sort</title>
    <description>Write an algorithm to sort a stack of integers in ascending order using a second stack.</description>
    <tags>
      <tag>Stacks</tag>
      <tag>Sorting</tag>
    </tags>
    <dataTypes>
      <inputType>Stack of integers</inputType>
      <inputName>STACK</inputName>
      <outputType>Stack of integers in ascending order</outputType>
    </dataTypes>
    <difficulty>HL</difficulty>
    <type>Algorithm</type>
    <testCases>
      <testCase>
        <input>Stack(3, 1, 4, 2)</input>
        <output>Stack([1, 2, 3, 4])</output>
      </testCase>
      <testCase>
        <input>Stack(5, 1, 3)</input>
        <output>Stack([1, 3, 5])</output>
      </testCase>
      <testCase>
        <input>Stack(10)</input>
        <output>Stack([10])</output>
      </testCase>
    </testCases>
  </challenge>
  <challenge>
    <id>5</id>
    <title>Bracket Matching</title>
    <description>Write an algorithm to check if the brackets &#40;parentheses, square, curly&#41; in a string are balanced using a stack.</description>
    <tags>
      <tag>Stacks</tag>
      <tag>Conditionals</tag>
    </tags>
    <dataTypes>
      <inputType>String of brackets &#40;parentheses, square, curly&#41;</inputType>
      <inputName>BRACKETS</inputName>
      <outputType>Boolean indicating if brackets are balanced</outputType>
    </dataTypes>
    <difficulty>HL</difficulty>
    <type>Algorithm</type>
    <testCases>
      <testCase>
        <input>"()[]{}"</input>
        <output>True</output>
      </testCase>
      <testCase>
        <input>"([)]"</input>
        <output>False</output>
      </testCase>
      <testCase>
        <input>"((()))"</input>
        <output>True</output>
      </testCase>
    </testCases>
  </challenge>
  <challenge>
    <id>6</id>
    <title>Merge Two Collections</title>
    <description>Write an algorithm to merge two collections into one and remove duplicates.</description>
    <tags>
      <tag>Collections</tag>
      <tag>Loops</tag>
    </tags>
    <dataTypes>
      <inputType>Collection of integers</inputType>
      <inputName>COLLECTION_ONE</inputName>
      <inputType>Collection of integers</inputType>
      <inputName>COLLECTION_TWO</inputName>
      <outputType>Collection of unique integers</outputType>
    </dataTypes>
    <difficulty>SL</difficulty>
    <type>Algorithm</type>
    <testCases>
      <testCase>
        <input>Collection(1, 2, 3)</input>
        <input>Collection(3, 4, 5)</input>
        <output>Collection([1, 2, 3, 4, 5])</output>
      </testCase>
      <testCase>
        <input>Collection(10, 20)</input>
        <input>Collection(20, 30, 40)</input>
        <output>Collection([10, 20, 30, 40])</output>
      </testCase>
      <testCase>
        <input>Collection()</input>
        <input>Collection(1, 2)</input>
        <output>Collection([1, 2])</output>
      </testCase>
    </testCases>
  </challenge>
  <challenge>
    <id>7</id>
    <title>Bubble Sort and Median</title>
    <description>Sort an array of integers using bubble sort and identify the median value as an integer.</description>
    <hint>If calculations are used on numbers, then a float may be returned. However, the expected output is of an integer, so "int&#40;FLOAT&#41;" may be used.</hint>
    <tags>
      <tag>Arrays</tag>
      <tag>Bubble Sort</tag>
    </tags>
    <dataTypes>
      <inputType>Array of unsorted integers.</inputType>
      <inputName>NUMBERS</inputName>
      <outputType>Integer representing the median value.</outputType>
    </dataTypes>
    <difficulty>SL</difficulty>
    <type>Algorithm</type>
    <testCases>
      <testCase>
        <input>Array(5, 3, 8, 6, 2)</input>
        <output>5</output>
      </testCase>
      <testCase>
        <input>Array(10, 1, 3, 5, 2)</input>
        <output>3</output>
      </testCase>
      <testCase>
        <input>Array(4, 7, 1, 2)</input>
        <output>3</output>
      </testCase>
    </testCases>
</challenge>
<challenge>
    <id>8</id>
    <title>Nearest Locations Queue</title>
    <description>Given a 2D array of locations with names and coordinates, return a queue of location names ordered by proximity to a given reference point.</description>
    <tags>
      <tag>2D Arrays</tag>
      <tag>Queues</tag>
      <tag>Sorting</tag>
    </tags>
    <dataTypes>
      <inputType>2D Array of strings and integers (location names and x, y coordinates).</inputType>
      <inputName>LOCATIONS</inputName>
      <inputType>Array of integers representing the reference x, y coordinates.</inputType>
      <inputName>REFERENCE</inputName>
      <outputType>Queue of strings representing location names in order of proximity.</outputType>
    </dataTypes>
    <difficulty>HL</difficulty>
    <type>Algorithm</type>
    <testCases>
      <testCase>
        <input>Array([[CustomString("Park"), 2, 3], [CustomString("Mall"), 5, 1], [CustomString("Cafe"), 1, 2]])</input>
        <input>Array(0, 0)</input>
        <output>Queue([CustomString("Cafe"),CustomString("Park"),CustomString("Mall")])</output>
      </testCase>
      <testCase>
        <input>Array([[CustomString("Home"), 0, 0], [CustomString("School"), 10, 10], [CustomString("Shop"), 5, 5]])</input>
        <input>Array(3, 3)</input>
        <output>Queue([CustomString("Shop"),CustomString("Home"),CustomString("School")])</output>
      </testCase>
      <testCase>
        <input>Array([[CustomString("Lake"), 4, 4], [CustomString("Mountain"), 8, 8], [CustomString("Museum"), 6, 5]])</input>
        <input>Array(5, 5)</input>
        <output>Queue([CustomString("Museum"),CustomString("Lake"),CustomString("Mountain")])</output>
      </testCase>
    </testCases>
</challenge>
